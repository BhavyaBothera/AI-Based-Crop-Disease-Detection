# Byte-compiled / optimized files
__pycache__/
*.py[cod]
*$py.class

# Virtual Environments
.venv/
venv/
env/
ENV/

# Environment variables & secrets
.env
.env.local
.env.*.local

# ML Datasets & Raw Archives (Keep local, never commit)
ml/data/
/data/
!backend/app/data/
datasets/
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z

# Model Weights, Large Checkpoints & Training Outputs
# By default, ignore all model binary weights in ml/models/ and subdirectories:
ml/models/**/*.keras
ml/models/**/*.h5
ml/models/**/*.savedmodel/
ml/models/**/*.tflite
ml/models/**/*.onnx
# Whitelist canonical serving and baseline evaluation checkpoints:
!ml/models/experiment_weighted/best_model.keras
!ml/models/experiment_unweighted/best_model.keras
!ml/models/input_gate/leaf_gate.keras
# Ignore intermediate training checkpoints and logs:
ml/models/checkpoints/
ml/checkpoints/
ml/logs/
ml/runs/

# Testing & Scratch Directories
scratch/
test_synthetic_data/
.browser_test_tmp/

# Academic Submission Package
/PHYTOSIGNAL_Project_Submission/

# IDE & OS Files
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
